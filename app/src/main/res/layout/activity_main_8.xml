<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2FAF9"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- HEADER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-35dp"
            app:cardBackgroundColor="#0E9488"
            app:cardCornerRadius="34dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="75dp"
                android:paddingEnd="24dp"
                android:paddingBottom="75dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#0E9488"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="QUEUE-LESS HEALTH"
                    android:textColor="#D9F3F0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Book Appointment"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Schedule your consultation with our doctor."
                    android:textColor="#D9F3F0"
                    android:textSize="13sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOOKING FORM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="-45dp"
            android:layout_marginEnd="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#D5E7E4"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOCTOR INFORMATION"
                    android:textColor="#0E9488"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Dr. A. Santos"
                    android:textColor="#12302D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="General Medicine"
                    android:textColor="#6B8E8A"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#E5EFED" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT INFORMATION"
                    android:textColor="#0E9488"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <!-- FULL NAME -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFullName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Full Name"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxStrokeColor="#0E9488">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- AGE -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAge"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Age"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxStrokeColor="#0E9488">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- GENDER -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Gender"
                    android:textColor="#526B68"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spGender"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/booking_spinner_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <!-- REASON -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReason"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Reason for appointment"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxStrokeColor="#0E9488">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReason"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:gravity="top"
                        android:inputType="textCapSentences|textMultiLine"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DATE AND TIME -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="APPOINTMENT SCHEDULE"
                    android:textColor="#0E9488"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDate"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#F2FAF9"
                    android:gravity="start|center_vertical"
                    android:text="Select Appointment Date"
                    android:textAllCaps="false"
                    android:textColor="#315D59"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconTint="#0E9488"
                    app:strokeColor="#CFE4E0"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTime"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp"
                    android:backgroundTint="#F2FAF9"
                    android:gravity="start|center_vertical"
                    android:text="Select Appointment Time"
                    android:textAllCaps="false"
                    android:textColor="#315D59"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_lock_idle_alarm"
                    app:iconTint="#0E9488"
                    app:strokeColor="#CFE4E0"
                    app:strokeWidth="1dp" />

                <!-- AVAILABLE SLOTS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Available Time Slots"
                    android:textColor="#12302D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSlot9"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="9:00 AM"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#0E9488" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSlot1030"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="10:30 AM"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#0E9488" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSlot2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="2:00 PM"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#0E9488" />
                </LinearLayout>

                <!-- PATIENT TYPE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="PATIENT TYPE"
                    android:textColor="#0E9488"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <RadioGroup
                    android:id="@+id/rgPatientType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Regular"
                        android:textColor="#315D59"
                        android:buttonTint="#0E9488" />

                    <RadioButton
                        android:id="@+id/rbPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Priority"
                        android:textColor="#315D59"
                        android:buttonTint="#0E9488" />
                </RadioGroup>

                <Spinner
                    android:id="@+id/spPriorityCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/booking_spinner_bg"
                    android:enabled="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <!-- CONFIRM BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmBooking"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="25dp"
                    android:backgroundTint="#0E9488"
                    android:fontFamily="sans-serif-medium"
                    android:text="CONFIRM BOOKING"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:cornerRadius="15dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Please review your details before confirming."
                    android:textColor="#91AAA6"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="20dp"
            android:text="Queue-Less Health • Your health, our priority."
            android:textColor="#91AAA6"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView
