<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F8F6">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:id="@+id/bookingConfirmedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="BOOKING CONFIRMED"
            android:textColor="#16834A"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Confirmation Image -->
        <ImageView
            android:id="@+id/confirmationImage"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/firefly"
            android:scaleType="fitCenter"
            android:contentDescription="Confirmation"
            app:layout_constraintTop_toBottomOf="@id/bookingConfirmedTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>