<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F9FC">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            app:tint="#1565C0"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Doctor Dashboard"
            android:textColor="#C62828"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="180dp"
            android:layout_height="115dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/firefly_removebackground" />
    </LinearLayout>

    <!-- Greeting -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:text="Hello, Doctor."
        android:textColor="#0D47A1"
        android:textSize="18sp" />

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnPending"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="PENDING"
            android:textSize="13sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnAccepted"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="ACCEPTED"
            android:textSize="13sp"
            android:backgroundTint="#E3F2FD"
            android:textColor="#0D47A1"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnRejected"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="REJECTED"
            android:textSize="13sp"
            android:backgroundTint="#E3F2FD"
            android:textColor="#0D47A1" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Patient Card 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPatient1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="#BBDEFB"
                        android:scaleType="centerInside"
                        android:contentDescription="Patient photo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvPatient1Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Patient 2"
                                android:textColor="#0D47A1"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPatient1Type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REGULAR"
                                android:textSize="11sp"
                                android:textColor="#1B5E20"
                                android:background="#C8E6C9"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPatient1Reason"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Reason: General Checkup"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPatient1Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="July 25, 2026: 9:00 AM"
                            android:textSize="13sp"
                            android:textColor="#424242"
                            android:layout_marginTop="2dp" />

                        <LinearLayout
                            android:id="@+id/layoutPatient1Actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">

                            <Button
                                android:id="@+id/btnAccept1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="ACCEPT"
                                android:textSize="13sp"
                                android:backgroundTint="#2E7D32"
                                android:textColor="#FFFFFF"
                                android:layout_marginEnd="8dp" />

                            <Button
                                android:id="@+id/btnReject1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="REJECT"
                                android:textSize="13sp"
                                android:backgroundTint="#546E7A"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Patient Card 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPatient2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:background="#BBDEFB"
                        android:scaleType="centerInside"
                        android:contentDescription="Patient photo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvPatient2Name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Patient 1"
                                android:textColor="#0D47A1"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPatient2Type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRIORITY"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:background="#C62828"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPatient2Reason"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Reason: Chest Pain Follow-up"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPatient2Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="July 25, 2026: 10:00 AM"
                            android:textSize="13sp"
                            android:textColor="#424242"
                            android:layout_marginTop="2dp" />

                        <LinearLayout
                            android:id="@+id/layoutPatient2Actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">

                            <Button
                                android:id="@+id/btnAccept2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:backgroundTint="#2E7D32"
                                android:text="ACCEPT"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:layout_marginEnd="8dp" />

                            <Button
                                android:id="@+id/btnReject2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:backgroundTint="#546E7A"
                                android:text="REJECT"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Empty State View -->
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="No appointments found for this category."
                android:textColor="#757575"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingVertical="8dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Home"
            android:textSize="12sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginHorizontal="4dp" />

        <Button
            android:id="@+id/navAppointment"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:backgroundTint="#E3F2FD"
            android:text="Appointment"
            android:textColor="#0D47A1"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navQueue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Queue"
            android:textSize="12sp"
            android:backgroundTint="#E3F2FD"
            android:textColor="#0D47A1"
            android:layout_marginHorizontal="4dp" />

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:backgroundTint="#E3F2FD"
            android:text="Profile"
            android:textColor="#0D47A1"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>